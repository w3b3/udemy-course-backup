# Udemy Authentication Credentials
# Extract these from your browser while logged into Udemy
# See docs/EXTRACT_COOKIES.md for detailed instructions

# Your Udemy access token (from Authorization header in browser DevTools)
# Format: Long JWT string starting with "eyJ..."
UDEMY_ACCESS_TOKEN=your_access_token_here

# Your Udemy client ID (from X-Udemy-Client-Id header in browser DevTools)
# Format: Alphanumeric string, usually ~32 characters
UDEMY_CLIENT_ID=your_client_id_here
